{
  "name": "xdebug-profiler-viewer",
  "displayName": "xdebug profiler viewer",
  "description": "A extension to view xdebug profiler files.",
  "version": "0.0.0-0",
  "publisher": "felipecavalca",
  "repository": {
    "type": "git",
    "url": "https://github.com/Felipe-Cavalca/xdebug-profiler-viewer.git"
  },
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "xdebug",
    "profiler",
    "profile",
    "profiling",
    "cachegrind",
    "performance",
    "php",
    "call graph",
    "flame graph",
    "hotspot",
    "cpu",
    "debugging"
  ],
  "activationEvents": [
    "onCustomEditor:xdebugProfileViewer.viewer",
    "onLanguage:php",
    "onLanguage:php8",
    "onLanguage:phtml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "xdebugProfileViewer.viewer",
        "displayName": "Xdebug Profile Viewer",
        "selector": [
          {
            "filenamePattern": "cachegrind.out.*"
          },
          {
            "filenamePattern": "*.out"
          },
          {
            "filenamePattern": "*.cachegrind"
          },
          {
            "filenamePattern": "*.cg"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "Xdebug Profile Viewer",
      "properties": {
        "xdebugProfileViewer.pathMappings": {
          "type": "object",
          "default": {},
          "description": "Map source path prefixes from profile files to local workspace paths. Example: {\"/var/www/html\":\"D:/Projetos/Bifrost-API\"}",
          "additionalProperties": {
            "type": "string"
          }
        },
        "xdebugProfileViewer.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable risk CodeLens above PHP function declarations."
        },
        "xdebugProfileViewer.codeLens.profilerIndexDebounceMs": {
          "type": "number",
          "default": 350,
          "minimum": 0,
          "description": "Debounce delay (ms) before indexing a created/changed profiler file."
        },
        "xdebugProfileViewer.codeLens.profilerIndexRetryMs": {
          "type": "number",
          "default": 900,
          "minimum": 100,
          "description": "Retry delay (ms) when a profiler file is detected but still incomplete for parsing."
        },
        "xdebugProfileViewer.codeLens.profilerIndexMaxRetries": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "description": "Maximum retry attempts for indexing a newly created/updated profiler file."
        },
        "xdebugProfileViewer.lineTimings.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable line timing inlay hints for PHP files based on indexed Xdebug trace files."
        },
        "xdebugProfileViewer.lineTimings.minDurationMs": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Minimum total line duration (ms) required to show a line timing hint."
        },
        "xdebugProfileViewer.lineTimings.showLoopsAsAggregate": {
          "type": "boolean",
          "default": true,
          "description": "When true, repeated execution of the same line is shown as total/count/avg."
        },
        "xdebugProfileViewer.lineTimings.maxHintsPerFile": {
          "type": "number",
          "default": 200,
          "minimum": 1,
          "description": "Maximum number of line timing hints shown per file."
        },
        "xdebugProfileViewer.lineTimings.traceGlobs": {
          "type": "array",
          "default": [
            "**/trace*.xt",
            "**/xdebug-trace*.xt",
            "**/*.trace",
            "**/*.xt"
          ],
          "description": "Glob patterns used to discover Xdebug TRACE files for line timings.",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.105.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.54.0",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
