// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
    "version": "2.0.0",
    "tasks": [

		// Scrips .github
		{
			"label": "mesclar .github/last-release com a branch atual",
			"type": "shell",
			"problemMatcher": [],
			"windows": {
				"command": "if (git remote | findstr 'github') { git remote set-url github https://github.com/Felipe-Cavalca/.github.git } else { git remote add github https://github.com/Felipe-Cavalca/.github.git }; git fetch github; git merge github/latest-release --allow-unrelated-histories"
			},
			"linux": {
				"command": "git remote | grep github && git remote set-url github https://github.com/Felipe-Cavalca/.github.git || git remote add github https://github.com/Felipe-Cavalca/.github.git; git fetch github && git merge github/latest-release --allow-unrelated-histories"
			}
		},

		{
			"type": "npm",
			"script": "watch",
			"problemMatcher": "$tsc-watch",
			"isBackground": true,
			"presentation": {
				"reveal": "never"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		}
	]
}
